# Copy to .env and adjust (never commit .env).
# Where the QuantumShield FastAPI backend runs (backend_dashboard, default port 8000).
VITE_API_BASE_URL=http://localhost:8000
# "true" = bundled demo data (default, no backend needed).
# "false" = LIVE: every page reads the real backend, and a WebSocket keeps them updating.
VITE_USE_MOCK_DATA=true
# Only if the backend has QS_API_KEY set. It is sent as the X-API-Key header.
# NOTE: any value here ships to the browser, so use it for demos only.
VITE_API_KEY=
