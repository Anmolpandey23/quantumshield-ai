{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1_output",
  "title": "Stage 1 output: AI threat prediction result for one node",
  "type": "object",
  "required": ["contract_version", "node_id", "threat_label", "confidence", "anomaly_score", "risk_score_node", "explanation"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "node_id": {"type": "string", "minLength": 1},
    "threat_label": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "anomaly_score": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_score_node": {"type": "number", "minimum": 0, "maximum": 1},
    "explanation": {"type": "array", "items": {"type": "string"}}
  }
}
